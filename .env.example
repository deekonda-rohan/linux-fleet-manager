PORT=5000
DB_USER=
DB_HOST=127.0.0.1
DB_NAME=
DB_PASSWORD=
DB_PORT=5432

HEARTBEAT_TIMEOUT_SECONDS=30
OFFLINE_CHECK_INTERVAL_SECONDS=10

# Leave unset to disable the remote-command API.
FLEET_ADMIN_TOKEN=
# JSON map keyed by registered node ID. Use absolute backend-local key paths.
# Keep private keys outside the repository and restrict their ACLs to the backend account.
FLEET_SSH_NODES={"5":{"sshUser":"fleetdiag","sshKeyPath":"C:\\path\\to\\node-5-key.pem"},"6":{"sshUser":"fleetdiag","sshKeyPath":"C:\\path\\to\\node-6-key.pem"}}
FLEET_SSH_TIMEOUT_MS=10000

# Leave the output path blank to disable automatic Prometheus discovery publishing.
PROMETHEUS_DISCOVERY_FILE=
PROMETHEUS_DISCOVERY_REFRESH_SECONDS=15
